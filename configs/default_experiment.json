{
  "env": {
    "max_episode_steps": 2500,
    "capture_distance": 6.0,
    "vehicle_touch_distance": 5.5,
    "pursuer_speed_mps": 4.0,
    "still_distance_threshold": 0.1,
    "self_lidar_ignore_distance": 0.06,
    "action_repeat": 4,
    "pursuer_start_delay_steps": 35,
    "reward_display_interval": 1,
    "show_car_display": false,
    "reset_vehicle_physics": true,
    "front_camera_names": ["front camera", "front Camera", "camera"],
    "back_camera_names": ["back camera", "rear camera"],
    "pursuer_recognition_tokens": ["pursuer", "Pursuer"]
  },
  "model": {
    "policy": "MultiInputLstmPolicy",
    "policy_kwargs": {
      "lstm_hidden_size": 256,
      "n_lstm_layers": 1,
      "shared_lstm": false,
      "enable_critic_lstm": true
    },
    "learning_rate": 0.0003,
    "n_steps": 512,
    "batch_size": 128,
    "gamma": 0.995,
    "gae_lambda": 0.95,
    "ent_coef": 0.01
  },
  "training": {
    "timesteps": 1000000,
    "checkpoint_freq": 50000,
    "metric_window": 20,
    "log_interval": 10,
    "save_name": "evader_recurrent_ppo"
  },
  "reward": {
    "moving_away_positive_weight": 4.0,
    "moving_away_negative_weight": 8.0,
    "include_moving_away_reward": false,
    "line_of_sight_hidden_reward": 1.0,
    "line_of_sight_break_bonus": 25.0,
    "line_of_sight_visible_penalty": -0.5,
    "visual_moving_away_weight": 12.0,
    "include_visual_moving_away_reward": true,
    "front_obstacle_penalty_weight": -9.0,
    "side_obstacle_penalty_weight": -2.0,
    "back_obstacle_penalty_weight": -1.0,
    "front_clearance_delta_weight": 3.0,
    "side_clearance_delta_weight": 1.0,
    "back_clearance_delta_weight": 0.5,
    "back_approach_penalty_weight": -3.0,
    "still_penalty": -3.0,
    "not_stuck_reward": 0.3,
    "movement_reward_weight": 4.0,
    "obstacle_stall_penalty": -1.0,
    "steering_penalty_weight": -0.01,
    "include_steering_penalty": false,
    "fast_turn_penalty_weight": -1.0,
    "tight_turn_penalty_weight": -2.0,
    "clear_front_turn_penalty_weight": -0.7,
    "straighten_reward_weight": 1.2,
    "turn_towards_obstacle_penalty_weight": -2.0,
    "clear_path_reward_weight": 0.4,
    "predicted_collision_penalty_weight": -8.0,
    "action_smoothness_penalty_weight": -0.3,
    "tilt_penalty_weight": -5.0,
    "overspeed_penalty_weight": -4.0,
    "drive_reward_weight": 0.08,
    "survival_reward_weight": 0.1
  }
}
