{
  "env": {
    "max_episode_steps": 1200,
    "obstacle_collision_termination_penalty": 180.0,
    "pursuer_start_delay_steps": 1000000,
    "randomize_obstacles": true,
    "randomize_all_buildings": true,
    "enriched_random_obstacles": true,
    "center_spawn_when_random_obstacles": true,
    "discrete_actions": true
  },
  "model": {
    "algorithm": "ppo",
    "policy": "MultiInputPolicy",
    "policy_kwargs": {
      "net_arch": [128, 128]
    },
    "learning_rate": 0.0003,
    "n_steps": 512,
    "batch_size": 128,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "ent_coef": 0.02
  },
  "training": {
    "timesteps": 500000,
    "checkpoint_freq": 25000,
    "metric_window": 20,
    "info_log_freq": 1000,
    "log_interval": 10,
    "save_name": "evader_obstacle_curriculum_ppo"
  },
  "reward": {
    "line_of_sight_hidden_reward": 0.0,
    "line_of_sight_break_bonus": 0.0,
    "line_of_sight_visible_penalty": 0.0,
    "visual_moving_away_weight": 0.0,
    "include_visual_moving_away_reward": false,
    "radial_escape_reward_weight": 0.0,
    "tangential_orbit_penalty_weight": 0.0,
    "turn_towards_visible_pursuer_penalty_weight": 0.0,
    "exploration_new_cell_reward": 1.0,
    "exploration_revisit_penalty": -0.02,
    "front_obstacle_penalty_weight": -4.0,
    "side_obstacle_penalty_weight": -0.4,
    "back_obstacle_penalty_weight": -0.1,
    "front_clearance_delta_weight": 2.5,
    "side_clearance_delta_weight": 0.6,
    "back_clearance_delta_weight": 0.2,
    "obstacle_collision_free_reward": 0.3,
    "front_blocked_speed_penalty_weight": 0.0,
    "front_blocked_drive_penalty_weight": 0.0,
    "front_blocked_straight_penalty_weight": -10.0,
    "front_blocked_brake_reward_weight": 0.0,
    "obstacle_action_reward_weight": 5.0,
    "obstacle_action_penalty_weight": -12.0,
    "obstacle_turn_commitment_reward_weight": 5.0,
    "obstacle_turn_switch_penalty_weight": -10.0,
    "obstacle_turn_progress_reward_weight": 7.0,
    "obstacle_wrong_heading_penalty_weight": -4.0,
    "obstacle_insufficient_turn_penalty_weight": -2.0,
    "obstacle_stall_penalty": -2.0,
    "movement_reward_weight": 1.0,
    "still_penalty": -3.0,
    "not_stuck_reward": 0.1,
    "fast_turn_penalty_weight": -0.2,
    "tight_turn_penalty_weight": -0.2,
    "long_curve_penalty_weight": 0.0,
    "straight_drive_reward_weight": 0.4,
    "clear_path_straight_reward_weight": 0.6,
    "unnecessary_turn_penalty_weight": -0.4,
    "over_avoidance_turn_penalty_weight": -0.5,
    "clear_front_turn_penalty_weight": -0.2,
    "straighten_reward_weight": 0.5,
    "turn_towards_obstacle_penalty_weight": -0.5,
    "predicted_collision_penalty_weight": -2.0,
    "action_smoothness_penalty_weight": -0.05,
    "drive_reward_weight": 0.04,
    "survival_reward_weight": 0.01
  }
}
